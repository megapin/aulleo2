# Upbit API 설정 (필수)
# Upbit 계정에서 API 키를 발급받아 설정하세요
# https://upbit.com/mypage/open_api_management
UPBIT_ACCESS_KEY=your_upbit_access_key_here
UPBIT_SECRET_KEY=your_upbit_secret_key_here

# PocketBase 설정 (선택)
# 기본값: http://anais.mheen.net/pb
# POCKETBASE_URL=http://localhost:8090

# 개발 환경 설정
NODE_ENV=development

# 애플리케이션 설정
APP_NAME=Aulleo2
APP_VERSION=2.0.0

# WebSocket 설정 (선택)
# Bithumb WebSocket URLs (기본값 사용 권장)
# BITHUMB_WS_PUBLIC=wss://ws-api.bithumb.com/websocket/v1
# BITHUMB_WS_PRIVATE=wss://ws-api.bithumb.com/websocket/v1/private

# 성능 설정 (선택)
# 가상 스크롤 설정
VIRTUAL_SCROLL_ITEM_HEIGHT=60
VIRTUAL_SCROLL_OVERSCAN=5

# WebSocket 재연결 설정
WS_RECONNECT_ATTEMPTS=5
WS_RECONNECT_DELAY=1000
WS_HEARTBEAT_INTERVAL=30000

# 캐시 설정
CACHE_MAX_SIZE=1000
CACHE_TTL=300000

# 알림 설정
ENABLE_BROWSER_NOTIFICATIONS=true
NOTIFICATION_PERMISSION_AUTO_REQUEST=true

# 로깅 설정
LOG_LEVEL=info
ENABLE_ERROR_REPORTING=true